LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# or Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# or Langdock (OpenAI-compatible gateway — needs both key and base url):
# LLM_PROVIDER=langdock
# LLM_MODEL=gpt-4o-mini
# LANGDOCK_API_KEY=...
# LANGDOCK_BASE_URL=https://api.langdock.com/openai/v1

# Web UI (chainlit run app.py). Required for the conversation sidebar: Chainlit
# stores threads per user, so history needs a login. There is no default password —
# leave these unset and nobody can sign in.
CHAINLIT_USER=you
CHAINLIT_PASSWORD=change-me
# generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET=paste-generated-secret-here

# Languages the bot may answer in — it replies in the language of the question.
# Comma-separated lingua names, at least two. Keep the list short: the more
# languages, the more often a short question is misdetected.
DETECT_LANGUAGES=English,Russian

# Confluence is optional and off unless both URL and SPACE_KEY are set. Left
# commented out on purpose: filled in with these placeholders, indexing prints a
# confusing "[confluence] skipped: Unauthorized (401)" about a source you never
# configured.
# CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
# CONFLUENCE_USERNAME=you@example.com
# CONFLUENCE_API_TOKEN=your-atlassian-api-token
# CONFLUENCE_SPACE_KEY=TEAM